# Workflow engine
WORKFLOW_DATA_ROOT=<path to this project>/data
# Optional: Google Cloud Storage bucket for reference + generated images (same bucket locally and on Cloud Run).
# Uses Application Default Credentials (e.g. gcloud auth application-default login, or the Cloud Run service account).
# WORKFLOW_GCS_BUCKET=your-project-id.appspot.com

# Gemini API
NANOBANANA_API_KEY=<your Gemini API key>
NANOBANANA_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Image generation (Custom Workflow steps, listing shots, etc.). Must be an image-capable Gemini model.
# Examples: gemini-3.1-flash-image-preview (faster) | gemini-3-pro-image-preview (quality)
NANOBANANA_MODEL=gemini-3-pro-image-preview
# Text-only model for custom workflow plan / replan (JSON). Does not affect image steps; use a cheap flash model.
# NANOBANANA_PLANNER_MODEL=gemini-2.5-flash
NANOBANANA_DRY_RUN=false

# Admin / Superuser (comma-separated Firebase UIDs — unlimited access, no quota)
# ADMIN_UIDS=

# Logging level (debug | info | warn | error — default: info)
# LOG_LEVEL=debug

# Real-ESRGAN upscaler (optional — binary path auto-detected from vendor/ or /app/bin)
# REALESRGAN_BIN=/path/to/realesrgan-ncnn-vulkan
# REALESRGAN_MODEL_DIR=/path/to/models

# Telegram Bot (from @BotFather)
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# TELEGRAM_WEBHOOK_URL=https://your-app.run.app/api/telegram/webhook

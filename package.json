{
  "name": "fashionmentum-image-workflow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "dev": "pnpm -C packages/web dev",
    "build:core": "pnpm -C packages/workflow-core build",
    "build:web": "pnpm -C packages/web build",
    "test:web": "pnpm -C packages/web test",
    "test:e2e": "pnpm -C packages/web test:e2e",
    "setup:main-image": "bash scripts/setup-main-image.sh",
    "merge-product-folders": "node scripts/merge-product-data-folders.mjs",
    "backfill:soft-delete": "bash scripts/backfill-soft-delete-fields.sh",
    "docker:push:cloud-run": "bash scripts/docker-build-push-cloud-run.sh",
    "deploy:cloud-run": "bash scripts/deploy-cloud-run.sh"
  },
  "devDependencies": {
    "ts-node": "^10.9.2"
  }
}

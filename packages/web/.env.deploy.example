# Copy to .env.deploy (gitignored). Loaded after .env.local when running pnpm deploy:cloud-run.
# Overrides NEXT_PUBLIC_APP_URL for the Next.js client bundle at Docker build time.

NEXT_PUBLIC_APP_URL=https://YOUR-SERVICE-HASH.europe-west1.run.app

# Optional (defaults shown):
# REGION=europe-west1
# CLOUD_RUN_SERVICE=grip-shot-web
# ARTIFACT_REPO=grip-shot
# PROJECT_ID=your-gcp-project-id
# IMAGE=europe-west1-docker.pkg.dev/PROJECT/grip-shot/web:latest
